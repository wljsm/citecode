# ── 模型接入 ────────────────────────────────────────────────
# DeepSeek 控制台：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 默认 deepseek-chat（支持 Function Calling）
CITECODE_MODEL=deepseek-chat
# 兼容 OpenAI 协议的服务地址；换其他服务时改这里
CITECODE_BASE_URL=https://api.deepseek.com

# ── Agent 行为 ──────────────────────────────────────────────
# 单次问答的「模型 ↔ 工具」往返上限
CITECODE_MAX_ROUNDS=24
# 单次问答允许的最大输出 token
CITECODE_MAX_TOKENS=2048
# 温度（分析类任务建议低温度）
CITECODE_TEMPERATURE=0.2

# ── 仓库工具 ────────────────────────────────────────────────
# 单文件读取上限（KB），超过则要求分段读取
CITECODE_MAX_FILE_KB=100
# 单次搜索返回的匹配行上限
CITECODE_MAX_SEARCH_HITS=80

# ── 录制 / 回放 ─────────────────────────────────────────────
# 设置后启用录制：把模型交互写入该目录，可离线回放
# CITECODE_CASSETTE_DIR=fixtures/cassettes
# 设置后启用回放：不调用真实模型，从 cassette 读取
# CITECODE_REPLAY=fixtures/cassettes/demo.jsonl
